---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../assets/styles/global.scss';
import { getLocaleFromUrl } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SEO title={title} description={description} image={image} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;700&family=Roboto:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- Global orbs that flow across all sections -->
  <div class="global-orbs" aria-hidden="true">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="orb orb-4"></div>
  </div>

  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>

<style is:global>
  :root {
    --primary-color: #2563eb;
    --secondary-color: #7c3aed;
    --font-color: #ffffff;
  }

  /* Global orbs that flow across all sections */
  .global-orbs {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }

  .global-orbs .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    animation: globalFloat 30s ease-in-out infinite;
    will-change: transform;
  }

  .global-orbs .orb-1 {
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.35) 0%, transparent 70%);
    top: -100px;
    right: -150px;
    animation-delay: 0s;
  }

  .global-orbs .orb-2 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.3) 0%, transparent 70%);
    top: 40%;
    left: -200px;
    animation-delay: -8s;
  }

  .global-orbs .orb-3 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.25) 0%, transparent 70%);
    top: 70%;
    right: 10%;
    animation-delay: -16s;
  }

  .global-orbs .orb-4 {
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, rgba(219, 39, 119, 0.2) 0%, transparent 70%);
    bottom: 5%;
    left: 20%;
    animation-delay: -22s;
  }

  @keyframes globalFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    20% { transform: translate(40px, -30px) scale(1.05); }
    40% { transform: translate(-30px, 50px) scale(0.95); }
    60% { transform: translate(50px, 20px) scale(1.03); }
    80% { transform: translate(-20px, -40px) scale(0.98); }
  }

  /* Shared grid pattern for hero and about sections */
  .shared-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 80% 50% at 50% 0%, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 50% at 50% 0%, black 40%, transparent 100%);
  }
</style>
