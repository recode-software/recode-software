---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageGallery from '../../components/ImageGallery.vue';
import { getLocaleFromUrl, t } from '../../i18n/translations';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.data.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const { Content } = await render(project);

const { slug, date, title, titlePl, url, technologies, numberOfScreenshots, descriptionPl } = project.data;

const displayTitle = locale === 'pl' && titlePl ? titlePl : title;
const formattedDate = new Date(date).toLocaleDateString(locale === 'pl' ? 'pl-PL' : 'en-GB', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric'
});
---

<BaseLayout
  title={displayTitle}
  description={locale === 'pl' && descriptionPl ? descriptionPl : undefined}
  image={`/images/projects/${slug}-mockup.webp`}
>
  <section class="project-page">
    <div class="container">
      <h1 class="page-title">{displayTitle}</h1>

      <div class="project-layout">
        <div class="project-image">
          <div class="image-container">
            <img src={`/images/projects/${slug}-mockup.webp`} alt={displayTitle} />
            <div class="image-decoration"></div>
          </div>
        </div>

        <div class="project-info">
          <div class="info-row">
            <span class="info-label">{locale === 'pl' ? 'Data' : 'Date'}</span>
            <span class="info-value">{formattedDate}</span>
          </div>

          <div class="info-row">
            <span class="info-label">{locale === 'pl' ? 'Strona' : 'Website'}</span>
            <a href={`https://${url}`} target="_blank" rel="noopener noreferrer" class="info-link">
              {url}
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>

          <div class="description">
            {locale === 'pl' && descriptionPl ? (
              <p>{descriptionPl}</p>
            ) : (
              <Content />
            )}
          </div>

          {technologies && technologies.length > 0 && (
            <div class="tech-section">
              <span class="info-label">{t(locale, 'technologies')}</span>
              <div class="tech-tags">
                {technologies.map(tech => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>

      {numberOfScreenshots > 0 && (
        <div class="screenshots-section">
          <h2>{t(locale, 'screenshots')}</h2>
          <ImageGallery client:visible slug={slug} count={numberOfScreenshots} />
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .project-page {
    padding: 8rem 1.5rem 5rem;
    min-height: 60vh;
  }

  .page-title {
    font-family: 'Roboto Mono', monospace;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 3rem;
    text-align: center;
  }

  .project-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-bottom: 4rem;

    @media (max-width: 1024px) {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .project-image {
    display: flex;
    justify-content: center;
  }

  .image-container {
    position: relative;
    width: 100%;
    max-width: 500px;

    img {
      width: 100%;
      border-radius: 16px;
      display: block;
      position: relative;
      z-index: 1;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
    }

    .image-decoration {
      position: absolute;
      inset: 0;
      border: 2px solid var(--primary-color);
      border-radius: 16px;
      transform: translate(12px, 12px);
      z-index: 0;
      opacity: 0.5;
    }
  }

  .project-info {
    padding: 1rem 0;
  }

  .info-row {
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .info-label {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #64748b;
  }

  .info-value {
    font-size: 1rem;
    color: #ffffff;
  }

  .info-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    color: var(--primary-color);
    text-decoration: none;
    transition: color 0.2s;

    svg {
      opacity: 0.7;
      transition: all 0.2s;
    }

    &:hover {
      color: #5a8ff0;

      svg {
        opacity: 1;
        transform: translate(2px, -2px);
      }
    }
  }

  .description {
    margin: 2rem 0;
    font-size: 1rem;
    line-height: 1.8;
    color: #94a3b8;

    :global(p) {
      margin: 0 0 1rem;
    }
  }

  .tech-section {
    margin-top: 1.5rem;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .tech-tag {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.8rem;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e2e8f0;
    border-radius: 8px;
    transition: all 0.2s;

    &:hover {
      background: rgba(37, 99, 235, 0.15);
      border-color: rgba(37, 99, 235, 0.3);
    }
  }

  .screenshots-section {
    margin-top: 4rem;
    padding-top: 4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);

    h2 {
      font-family: 'Roboto Mono', monospace;
      font-size: 1.5rem;
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 2rem;
    }
  }
</style>
