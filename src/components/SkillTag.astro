---
interface Props {
  name: string;
  level: 'advanced' | 'intermediate';
  accent: string;
  projects?: number;
}

const { name, level, accent, projects } = Astro.props;
const dots = level === 'advanced' ? 3 : 2;
---

<span class="skill-tag" style={`--accent: ${accent}`}>
  <span class="skill-name">{name}</span>
  <span class="skill-dots">
    {[1, 2, 3].map(i => (
      <span class={`dot ${i <= dots ? 'filled' : 'empty'}`} />
    ))}
  </span>
  {projects && <span class="skill-projects">{projects}+</span>}
</span>

<style lang="scss">
  .skill-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    transition: all 0.2s ease;

    &:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: var(--accent);

      .dot.filled {
        box-shadow: 0 0 6px var(--accent);
      }
    }
  }

  .skill-name {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.7rem;
    font-weight: 500;
    color: #cbd5e1;
  }

  .skill-dots {
    display: flex;
    gap: 3px;
    align-items: center;
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    transition: all 0.2s ease;

    &.filled {
      background: var(--accent);
    }

    &.empty {
      background: rgba(255, 255, 255, 0.15);
    }
  }

  .skill-projects {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.6rem;
    font-weight: 600;
    color: var(--accent);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }
</style>
