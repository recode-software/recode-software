---
import { getLocaleFromUrl } from '../i18n/translations';

const locale = getLocaleFromUrl(Astro.url);

const companies = locale === 'pl' ? [
  { name: 'CargoNest', role: 'Platforma logistyczna z AI', metric: '105+ modułów', accent: '#2563eb' },
  { name: 'MERA', role: 'System biletowy DDD', metric: '43 pakiety', accent: '#7c3aed' },
  { name: 'Recode Software', role: 'Własne projekty', metric: '12+ projektów', accent: '#22c55e' },
  { name: 'RST', role: 'Projekty klienckie', metric: '4 projekty', accent: '#f59e0b' },
] : [
  { name: 'CargoNest', role: 'Logistics platform with AI', metric: '105+ modules', accent: '#2563eb' },
  { name: 'MERA', role: 'DDD ticketing system', metric: '43 packages', accent: '#7c3aed' },
  { name: 'Recode Software', role: 'Own projects', metric: '12+ projects', accent: '#22c55e' },
  { name: 'RST', role: 'Client projects', metric: '4 projects', accent: '#f59e0b' },
];
---

<div class="company-strip">
  {companies.map((company, index) => (
    <div class="company-card" style={`--accent: ${company.accent}; --delay: ${index * 0.1}s`}>
      <span class="company-name">{company.name}</span>
      <span class="company-role">{company.role}</span>
      <span class="company-metric">{company.metric}</span>
    </div>
  ))}
</div>

<style lang="scss">
  .company-strip {
    display: flex;
    gap: 1rem;
    margin-bottom: 2.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.5rem;

    &::-webkit-scrollbar {
      height: 4px;
    }

    &::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.02);
    }

    &::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 2px;
    }
  }

  .company-card {
    flex: 1;
    min-width: 200px;
    scroll-snap-align: start;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    transition: all 0.3s ease;
    animation: fadeInUp 0.5s ease forwards;
    animation-delay: var(--delay);
    opacity: 0;

    &:hover {
      border-color: var(--accent);
      background: rgba(255, 255, 255, 0.04);
    }

    @media (max-width: 600px) {
      min-width: 180px;
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .company-name {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
  }

  .company-role {
    font-size: 0.8rem;
    color: #64748b;
  }

  .company-metric {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    margin-top: 0.25rem;
  }
</style>
