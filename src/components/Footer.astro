---
import { getLocaleFromUrl, t } from '../i18n/translations';

const locale = getLocaleFromUrl(Astro.url);
const basePath = locale === 'en' ? '/en' : '';
const currentYear = new Date().getFullYear();
---

<div id="contact" class="footer-section">
  <div class="container">
    <!-- CTA Section -->
    <div class="cta-block">
      <span class="cta-label">{t(locale, 'footerCta')}</span>
      <h2 class="cta-title">
        {t(locale, 'footerHi')}
      </h2>
      <a href="mailto:przemyslaw.szejna@recode-software.eu" class="cta-email">
        przemyslaw.szejna@recode-software.eu
      </a>
      <div class="social-row">
        <a href="https://www.facebook.com/przemyslaw.szejna" target="_blank" rel="noopener noreferrer" class="social-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          <span>Facebook</span>
        </a>
        <a href="https://www.linkedin.com/in/przemys%C5%82aw-szejna" target="_blank" rel="noopener noreferrer" class="social-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          <span>LinkedIn</span>
        </a>
        <a href="https://github.com/hazryn" target="_blank" rel="noopener noreferrer" class="social-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>

    <!-- Footer Grid -->
    <div class="footer-grid">
      <div class="footer-col brand">
        <img src="/images/white-logo.svg" alt="Recode Software" class="footer-logo" />
        <p class="brand-desc">{locale === 'pl' ? 'Tworzę nowoczesne aplikacje webowe i rozwiązania AI dla firm.' : 'Building modern web applications and AI solutions for businesses.'}</p>
      </div>

      <div class="footer-col">
        <h4 class="col-title">{t(locale, 'navigation')}</h4>
        <nav class="footer-nav">
          <a href={`${basePath}/`}>{t(locale, 'home')}</a>
          <a href={`${basePath}/#about-me`}>{t(locale, 'aboutMe')}</a>
          <a href={`${basePath}/projects`}>{t(locale, 'projects')}</a>
          <a href={`${basePath}/#services`}>{t(locale, 'services')}</a>
          <a href={`${basePath}/#experience`}>{t(locale, 'experience')}</a>
        </nav>
      </div>

      <div class="footer-col">
        <h4 class="col-title">{t(locale, 'contact')}</h4>
        <div class="contact-info">
          <a href="mailto:przemyslaw.szejna@recode-software.eu">przemyslaw.szejna@recode-software.eu</a>
          <span class="location">{locale === 'pl' ? 'Polska' : 'Poland'}</span>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <footer class="bottom-bar">
      <div class="copyright">
        &copy; {currentYear} Recode Software. {t(locale, 'allRightsReserved')}
      </div>
      <a href={`${basePath}/privacy-policy`} class="privacy-link">
        {t(locale, 'privacyPolicy')}
      </a>
    </footer>
  </div>
</div>

<style lang="scss">
  .footer-section {
    position: relative;
    z-index: 2;
    background: rgba(0, 0, 0, 0.3);
    padding: 6rem 1.5rem 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    overflow: visible;
  }


  // CTA Block
  .cta-block {
    position: relative;
    z-index: 1;
    text-align: center;
    margin-bottom: 5rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .cta-label {
    display: inline-block;
    font-family: 'Roboto Mono', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--primary-color);
    background: rgba(37, 99, 235, 0.1);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    margin-bottom: 1.5rem;
  }

  .cta-title {
    font-family: 'Roboto Mono', monospace;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    color: white;
    margin: 0 0 1rem;
    line-height: 1.3;
  }

  .cta-email {
    display: inline-block;
    font-family: 'Roboto Mono', monospace;
    font-size: clamp(1rem, 3vw, 1.5rem);
    font-weight: 600;
    color: var(--primary-color);
    text-decoration: none;
    margin-bottom: 2rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    transition: all 0.3s ease;
    word-break: break-word;

    &:hover {
      background: rgba(37, 99, 235, 0.1);
    }
  }

  .social-row {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.875rem;
    text-decoration: none;
    padding: 0.75rem 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    transition: all 0.3s ease;

    svg {
      opacity: 0.7;
      transition: opacity 0.2s;
    }

    &:hover {
      color: white;
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(37, 99, 235, 0.3);
      transform: translateY(-2px);

      svg {
        opacity: 1;
      }
    }
  }

  // Footer Grid
  .footer-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }
  }

  .footer-col {
    &.brand {
      @media (max-width: 768px) {
        order: -1;
      }
    }
  }

  .footer-logo {
    height: 36px;
    margin-bottom: 1rem;
    opacity: 0.9;
  }

  .brand-desc {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0;
    max-width: 280px;

    @media (max-width: 768px) {
      max-width: none;
    }
  }

  .col-title {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.4);
    margin: 0 0 1.25rem;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;

    a {
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;

      &:hover {
        color: var(--primary-color);
      }
    }
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;

    a {
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;
      word-break: break-word;

      &:hover {
        color: var(--primary-color);
      }
    }

    .location {
      color: rgba(255, 255, 255, 0.4);
      font-size: 0.875rem;
    }
  }

  // Bottom Bar
  .bottom-bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);

    @media (max-width: 768px) {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }

  .copyright {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.85rem;
  }

  .privacy-link {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 0.2s;

    &:hover {
      color: var(--primary-color);
    }
  }
</style>
