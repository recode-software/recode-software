---
import { getLocaleFromUrl } from '../i18n/translations';

const locale = getLocaleFromUrl(Astro.url);
const basePath = locale === 'en' ? '/en' : '';

const titleLine1 = locale === 'pl' ? 'Rozwiń Swój Biznes' : 'Elevate Your Business';
const titleLine2 = locale === 'pl' ? 'z Naszym Kodem' : 'with Our Code';
const subtitle = locale === 'pl'
  ? 'Full-stack developer z pasją do tworzenia nowoczesnych aplikacji webowych'
  : 'Full-stack developer passionate about building modern web applications';
const buttonText = locale === 'pl' ? 'Zobacz Projekty' : 'View Projects';
const contactText = locale === 'pl' ? 'Kontakt' : 'Contact';

const techStack = [
  // Languages & Core
  { name: 'TypeScript', color: '#3178c6' },
  { name: 'JavaScript', color: '#f7df1e' },
  { name: 'PHP', color: '#777bb4' },
  { name: 'Python', color: '#3776ab' },
  // Frontend
  { name: 'React', color: '#61dafb' },
  { name: 'Vue.js', color: '#42b883' },
  { name: 'Nuxt.js', color: '#00dc82' },
  { name: 'Astro', color: '#ff5d01' },
  { name: 'Tailwind', color: '#06b6d4' },
  { name: 'shadcn/ui', color: '#ffffff' },
  // Backend
  { name: 'Node.js', color: '#339933' },
  { name: 'Nest.js', color: '#e0234e' },
  { name: 'GraphQL', color: '#e10098' },
  { name: 'REST API', color: '#6b7280' },
  // Databases
  { name: 'PostgreSQL', color: '#4169e1' },
  { name: 'MySQL', color: '#4479a1' },
  { name: 'MongoDB', color: '#47a248' },
  { name: 'Redis', color: '#dc382d' },
  // DevOps & Cloud
  { name: 'Docker', color: '#2496ed' },
  { name: 'AWS', color: '#ff9900' },
  { name: 'Linux', color: '#fcc624' },
  { name: 'CI/CD', color: '#40be46' },
  // Real-time & AI
  { name: 'WebSockets', color: '#010101' },
  { name: 'RabbitMQ', color: '#ff6600' },
  { name: 'OpenAI API', color: '#412991' },
  { name: 'Claude API', color: '#d4a27f' },
];
---

<section class="hero">
  <!-- Shared grid pattern with about section -->
  <div class="shared-grid-bg"></div>

  <div class="container">
    <div class="hero-content">
      <div class="hero-text">
        <h1 class="title">
          <span class="title-line">{titleLine1}</span>
          <span class="title-line highlight">{titleLine2}</span>
        </h1>
        <p class="subtitle">{subtitle}</p>
        <div class="cta-group">
          <a href={`${basePath}/projects`} class="btn-primary">
            <span>{buttonText}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href={`${basePath}/#contact`} class="btn-secondary">
            {contactText}
          </a>
        </div>
      </div>

      <div class="tech-stack">
        <span class="tech-label">{locale === 'pl' ? 'Tech Stack' : 'Tech Stack'}</span>
        <div class="tech-grid">
          {techStack.map((tech, index) => (
            <div class="tech-tile" style={`--accent: ${tech.color}; --delay: ${index * 0.05}s`}>
              <span class="tech-dot"></span>
              <span class="tech-name">{tech.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 6rem 1.5rem 4rem;
    overflow: visible;
  }


  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .hero-text {
    max-width: 800px;
  }

  .title {
    margin: 0 0 1.5rem;
  }

  .title-line {
    display: block;
    font-family: 'Roboto Mono', monospace;
    font-size: clamp(1.75rem, 5vw, 5rem);
    font-weight: 700;
    line-height: 1.1;
    color: #ffffff;
    white-space: nowrap;

    &.highlight {
      background: linear-gradient(135deg, #2563eb 0%, #7c3aed 50%, #ec4899 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
  }

  .subtitle {
    font-size: clamp(0.9rem, 2vw, 1.25rem);
    color: #94a3b8;
    line-height: 1.6;
    margin: 0 0 2rem;
    white-space: nowrap;
  }

  .cta-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 1rem 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    color: white;
    background: linear-gradient(135deg, var(--primary-color) 0%, #7c3aed 100%);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: 0 4px 20px rgba(37, 99, 235, 0.3);

    svg {
      transition: transform 0.2s;
    }

    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(37, 99, 235, 0.4);

      svg {
        transform: translateX(4px);
      }
    }
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 1rem 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.3s;

    &:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.25);
    }
  }

  .tech-stack {
    width: 100%;
  }

  .tech-label {
    display: inline-block;
    font-family: 'Roboto Mono', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #64748b;
    margin-bottom: 1.25rem;
  }

  .tech-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tech-tile {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    transition: all 0.3s ease;
    animation: fadeInUp 0.5s ease forwards;
    animation-delay: var(--delay);
    opacity: 0;

    &:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: var(--accent);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);

      .tech-dot {
        transform: scale(1.3);
        box-shadow: 0 0 12px var(--accent);
      }

      .tech-name {
        color: #ffffff;
      }
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .tech-dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
    transition: all 0.3s;
  }

  .tech-name {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.875rem;
    font-weight: 500;
    color: #cbd5e1;
    transition: color 0.2s;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 5rem 1rem 3rem;
      min-height: auto;
    }

    .hero-content {
      gap: 3rem;
    }

    .subtitle {
      font-size: 1.1rem;
    }

    .cta-group {
      flex-direction: column;

      .btn-primary,
      .btn-secondary {
        justify-content: center;
      }
    }

    .tech-grid {
      gap: 0.5rem;
    }

    .tech-tile {
      padding: 0.5rem 0.75rem;
    }

    .tech-name {
      font-size: 0.8rem;
    }
  }
</style>
