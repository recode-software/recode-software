---
import Button from './Button.astro';
import { getLocaleFromUrl } from '../i18n/translations';

const locale = getLocaleFromUrl(Astro.url);
const basePath = locale === 'en' ? '/en' : '';

// Dynamiczne obliczanie lat doświadczenia od 11.05.2015
const careerStart = new Date('2015-05-11');
const now = new Date();
const years = Math.floor((now.getTime() - careerStart.getTime()) / (1000 * 60 * 60 * 24 * 365.25));

const content = {
  pl: {
    greeting: 'Cześć, jestem',
    name: 'Przemysław',
    surname: 'Szejna',
    role: 'Full Stack Developer',
    status: 'Dostępny do współpracy',
    bio: 'Tworzę aplikacje webowe, systemy biznesowe i rozwiązania AI. Specjalizuję się w Node.js, Vue.js i TypeScript.',
    stats: [
      { value: `${years}+`, label: 'lat doświadczenia', icon: 'calendar' },
      { value: '50+', label: 'projektów', icon: 'folder' },
      { value: '∞', label: 'kawy', icon: 'coffee' }
    ],
    stack: ['TypeScript', 'JavaScript', 'Node.js', 'Nest.js', 'Vue.js', 'React', 'Nuxt.js', 'Astro', 'PostgreSQL', 'MongoDB', 'Redis', 'Docker', 'AWS', 'GraphQL', 'Tailwind'],
    hireMeBtn: 'Porozmawiajmy',
    projectsBtn: 'Zobacz projekty'
  },
  en: {
    greeting: "Hi, I'm",
    name: 'Przemysław',
    surname: 'Szejna',
    role: 'Full Stack Developer',
    status: 'Available for work',
    bio: 'I build web applications, business systems, and AI solutions. Specializing in Node.js, Vue.js, and TypeScript.',
    stats: [
      { value: `${years}+`, label: 'years experience', icon: 'calendar' },
      { value: '50+', label: 'projects', icon: 'folder' },
      { value: '∞', label: 'coffee', icon: 'coffee' }
    ],
    stack: ['TypeScript', 'JavaScript', 'Node.js', 'Nest.js', 'Vue.js', 'React', 'Nuxt.js', 'Astro', 'PostgreSQL', 'MongoDB', 'Redis', 'Docker', 'AWS', 'GraphQL', 'Tailwind'],
    hireMeBtn: "Let's talk",
    projectsBtn: 'View projects'
  }
};

const c = content[locale];
---

<section id="about-me" class="hero-section">
  <!-- Shared grid pattern with hero -->
  <div class="shared-grid-bg"></div>

  <div class="container">
    <div class="bento-grid">
      <!-- Main Hero Card -->
      <div class="bento-card card-main">
        <span class="greeting">{c.greeting}</span>
        <h1 class="name">
          <span class="name-first">{c.name}</span>
          <span class="name-last">{c.surname}</span>
        </h1>
        <p class="role">{c.role}</p>
        <p class="bio">{c.bio}</p>
        <div class="hero-buttons">
          <a href={`${basePath}/#contact`}>
            <Button>{c.hireMeBtn}</Button>
          </a>
          <a href={`${basePath}/#projects`}>
            <Button variant="outline">{c.projectsBtn}</Button>
          </a>
        </div>
      </div>

      <!-- Photo Card -->
      <div class="bento-card card-photo">
        <img src="/images/me.webp?v=2" alt="Przemysław Szejna" />
        <div class="photo-overlay"></div>
      </div>

      <!-- Status Card -->
      <div class="bento-card card-status">
        <div class="status-indicator">
          <span class="status-dot"></span>
          <span class="status-text">{c.status}</span>
        </div>
      </div>

      <!-- Stats Cards -->
      {c.stats.map((stat, i) => (
        <div class={`bento-card card-stat card-stat-${i + 1}`}>
          <span class="stat-value">{stat.value}</span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))}

      <!-- Tech Stack Card -->
      <div class="bento-card card-stack">
        <div class="stack-header">Tech Stack</div>
        <div class="stack-tags">
          {c.stack.map(tech => (
            <span class="stack-tag">{tech}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .hero-section {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    padding: 8rem 0 4rem;
    // Allow orbs to overflow
    overflow: visible;
  }


  .bento-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto auto auto auto;
    gap: 1rem;
    max-width: 1100px;
    margin: 0 auto;

    @media (max-width: 900px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (max-width: 600px) {
      grid-template-columns: 1fr;
    }
  }

  .bento-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 1.5rem;
    transition: all 0.3s ease;

    &:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.15);
      transform: translateY(-2px);
    }
  }

  // Main card - spans 2 columns
  .card-main {
    grid-column: span 2;
    grid-row: span 2;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;

    @media (max-width: 600px) {
      grid-column: span 1;
      grid-row: span 1;
      text-align: center;
    }
  }

  .greeting {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.9rem;
    color: #94a3b8;
    margin-bottom: 0.5rem;
    display: block;
  }

  .name {
    font-family: 'Roboto Mono', monospace;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;

    @media (max-width: 600px) {
      align-items: center;
    }
  }

  .name-first {
    color: #ffffff;
  }

  .name-last {
    background: linear-gradient(135deg, #2563eb 0%, #7c3aed 50%, #db2777 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .role {
    font-size: 1.25rem;
    font-weight: 500;
    color: #64748b;
    margin: 0 0 1rem;
  }

  .bio {
    font-size: 1rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0 0 1.5rem;
    max-width: 400px;

    @media (max-width: 600px) {
      max-width: none;
    }
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;

    @media (max-width: 600px) {
      justify-content: center;
    }

    // Override button styles for dark background
    :global(.btn.outline) {
      border-color: rgba(255, 255, 255, 0.3);
      color: #ffffff;

      &:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.5);
      }
    }
  }

  // Photo card
  .card-photo {
    grid-column: span 2;
    grid-row: span 2;
    padding: 0;
    overflow: hidden;
    position: relative;
    min-height: 300px;

    @media (max-width: 900px) {
      order: -1;
      min-height: 250px;
    }

    @media (max-width: 600px) {
      grid-column: span 1;
      min-height: 300px;
    }

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }

    .photo-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 60%, rgba(10, 10, 15, 0.8) 100%);
    }
  }

  // Status card
  .card-status {
    grid-column: span 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 197, 94, 0.1);
    border-color: rgba(34, 197, 94, 0.2);

    @media (max-width: 600px) {
      grid-column: span 1;
    }
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .status-dot {
    width: 10px;
    height: 10px;
    background: #22c55e;
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
    box-shadow: 0 0 20px rgba(34, 197, 94, 0.5);
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.1); }
  }

  .status-text {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.9rem;
    font-weight: 500;
    color: #22c55e;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  // Stat cards
  .card-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 120px;
  }

  .card-stat-1 {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.15) 0%, rgba(37, 99, 235, 0.05) 100%);
    border-color: rgba(37, 99, 235, 0.2);
  }

  .card-stat-2 {
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.15) 0%, rgba(124, 58, 237, 0.05) 100%);
    border-color: rgba(124, 58, 237, 0.2);
  }

  .card-stat-3 {
    background: linear-gradient(135deg, rgba(219, 39, 119, 0.15) 0%, rgba(219, 39, 119, 0.05) 100%);
    border-color: rgba(219, 39, 119, 0.2);
  }

  .stat-value {
    font-family: 'Roboto Mono', monospace;
    font-size: 2.5rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-size: 0.8rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  // Tech stack card
  .card-stack {
    grid-column: span 3;

    @media (max-width: 900px) {
      grid-column: span 2;
    }

    @media (max-width: 600px) {
      grid-column: span 1;
    }
  }

  .stack-header {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stack-tag {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.8rem;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #e2e8f0;
    transition: all 0.2s ease;

    &:hover {
      background: rgba(37, 99, 235, 0.2);
      border-color: rgba(37, 99, 235, 0.4);
      color: #ffffff;
    }
  }
</style>
